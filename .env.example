# Copy to .env and fill in. Never commit .env.
# Variable names only; no real values.

# LLM: DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# Embeddings: local Ollama model (DeepSeek has no embeddings API)
EMBED_MODEL=nomic-embed-text
# From inside Docker (M6) use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Vision captions: DeepSeek image input, reusing DEEPSEEK_API_KEY above.
# Extracted images are sent to the hosted API; normal API usage charges apply.
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-flash
# Blank uses https://api.deepseek.com for deepseek.
# Optional local alternative: VISION_PROVIDER=ollama, VISION_MODEL=gemma3:4b;
# then a blank VISION_BASE_URL reuses OLLAMA_BASE_URL. Pull the model separately.
VISION_BASE_URL=
VISION_TIMEOUT=120

# PDF extraction (no OCR). IMAGE_DIR must be within the application directory.
IMAGE_DIR=data/images
PDF_MIN_IMAGE_PIXELS=64
# Render substantial clusters of vector drawings as cropped images, not every page.
PDF_VECTOR_FALLBACK=true
PDF_VECTOR_MIN_PATHS=3
PDF_RENDER_DPI=144
# Per-upload size limit (20 MiB); rejected before saving or caption requests.
MAX_UPLOAD_BYTES=20971520

# Qdrant (use "qdrant" as host when running inside Docker Compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Chunking and retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=3
