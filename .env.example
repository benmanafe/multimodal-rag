# Copy to .env and fill in. Never commit .env.
# Variable names only; the LLM/embedding provider is still undecided (see PLAN.md).

# LLM / embeddings (set the ones for the provider you choose)
LLM_PROVIDER=
EMBED_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant (use "qdrant" as host when running inside Docker Compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Chunking and retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=3
